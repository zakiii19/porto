---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import HeroSection from '../components/HeroSection';
import CareerSnapshot from '../components/CareerSnapshot';
import FeaturedProjects from '../components/FeaturedProjects';
import CompetencyMatrix from '../components/CompetencyMatrix';
import ContactHub from '../components/ContactHub';
import DesktopHintToast from '../components/DesktopHintToast';
import Footer from '../components/Footer';

const allProjects = await getCollection('projects');
const sorted = allProjects
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.localeCompare(a.data.date))
  .map((entry) => ({
    slug: entry.id.replace(/\.mdx?$/, ''),
    title: entry.data.title,
    category: entry.data.category,
    featured: entry.data.featured,
    date: entry.data.date,
    summary: entry.data.summary,
    thumbnail: entry.data.thumbnail,
    role: entry.data.role,
    tools: entry.data.tools,
  }));
---

<Layout>
  <Navbar client:load />
  <main class="flex-1">
    <HeroSection client:load />
    <CareerSnapshot client:load />
    <FeaturedProjects client:load projects={sorted} />
    <CompetencyMatrix client:load />
    <ContactHub client:load />
  </main>
  <Footer />
  <DesktopHintToast client:load />
</Layout>
