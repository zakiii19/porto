---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import { ProjectDetailHeader, ProjectDetailNav } from '../../components/ProjectDetailChrome';
import Footer from '../../components/Footer';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  const sorted = entries.sort(
    (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.localeCompare(a.data.date)
  );

  return sorted.map((entry, idx) => {
    const prevEntry = sorted[(idx - 1 + sorted.length) % sorted.length];
    const nextEntry = sorted[(idx + 1) % sorted.length];
    return {
      params: { slug: entry.id.replace(/\.mdx?$/, '') },
      props: {
        entry,
        prev: {
          slug: prevEntry.id.replace(/\.mdx?$/, ''),
          title: prevEntry.data.title,
          category: prevEntry.data.category,
        },
        next: {
          slug: nextEntry.id.replace(/\.mdx?$/, ''),
          title: nextEntry.data.title,
          category: nextEntry.data.category,
        },
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.mdx?$/, '');
const { title, category, date, summary, thumbnail, role, tools, deliverables, liveUrl, figmaUrl } = entry.data;
---

<Layout title={`${title} | Qolbul Muzaki`} description={summary} image={thumbnail}>
  <Navbar client:load />

  <main class="relative flex-1 overflow-hidden pt-24 pb-12 md:pt-28 md:pb-16">
    <!-- Subtle Sunlit Top Wash -->
    <div class="hero-sunlit-canvas pointer-events-none absolute inset-x-0 top-0 h-[360px]" aria-hidden="true">
      <div
        class="absolute inset-x-0 bottom-0 h-32"
        style="background: linear-gradient(180deg, transparent 0%, var(--bg) 100%);"
      />
    </div>

    <div class="relative z-10 max-w-[920px] mx-auto px-6">
      <ProjectDetailHeader
        client:load
        slug={slug}
        title={title}
        category={category}
        date={date}
        summary={summary}
        thumbnail={thumbnail}
        role={role}
        tools={tools}
        deliverables={deliverables}
        liveUrl={liveUrl}
        figmaUrl={figmaUrl}
      />

      <article class="prose max-w-none">
        <Content />
      </article>

      <ProjectDetailNav client:load prev={prev} next={next} />
    </div>
  </main>

  <Footer />
</Layout>
