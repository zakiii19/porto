---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import { Calendar, User, Hammer, CheckSquare, ExternalLink, ArrowLeft, ChevronLeft, ChevronRight } from 'lucide-react';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  
  // Sort projects chronologically (newest first)
  const sorted = projects.sort((a, b) => b.data.date.localeCompare(a.data.date));
  
  return sorted.map((project, index) => {
    // Next/Prev mapping (descending order, so index-1 is newer/next, index+1 is older/prev)
    const prevProject = index < sorted.length - 1 ? sorted[index + 1] : null;
    const nextProject = index > 0 ? sorted[index - 1] : null;
    
    return {
      params: { slug: project.id },
      props: { project, prevProject, nextProject },
    };
  });
}

const { project, prevProject, nextProject } = Astro.props;
const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} | Case Study`}
  description={project.data.summary}
  image={project.data.thumbnail}
>
  <Navbar client:load />

  <main class="flex-grow">
    {/* Hero Banner Section */}
    <section class="relative h-[45vh] min-h-[350px] flex items-end justify-start overflow-hidden bg-zinc-950">
      {/* Background Cover */}
      <div class="absolute inset-0 z-0">
        <img
          src={project.data.thumbnail}
          alt={project.data.title}
          class="w-full h-full object-cover opacity-35"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/60 to-transparent"></div>
      </div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full pb-12">
        <a
          href="/projects"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-violet-400 hover:text-violet-300 mb-6 transition-colors group"
        >
          <ArrowLeft className="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" />
          <span>Back to Case Studies</span>
        </a>

        <div class="max-w-4xl">
          <span class="text-[10px] uppercase font-bold tracking-widest text-violet-400 bg-violet-500/10 border border-violet-500/20 px-2.5 py-1 rounded-md inline-block mb-4">
            {project.data.category}
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight">
            {project.data.title}
          </h1>
        </div>
      </div>
    </section>

    {/* Metadata & Case Study Content */}
    <section class="py-16 bg-zinc-950">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          
          {/* Left Metadata Panel (4 cols on desktop) */}
          <aside class="lg:col-span-4 bg-zinc-900/30 border border-zinc-800 rounded-2xl p-6 sm:p-8 space-y-6 sticky top-24">
            <h2 class="text-base font-bold text-zinc-100 uppercase tracking-widest border-b border-zinc-850 pb-4">
              Project Parameters
            </h2>

            {/* Role */}
            <div class="space-y-1">
              <span class="text-[10px] uppercase font-bold text-zinc-500 tracking-wider flex items-center gap-1.5">
                <User className="w-3.5 h-3.5 text-violet-400" />
                <span>My Role</span>
              </span>
              <p class="text-sm font-semibold text-zinc-200">{project.data.role}</p>
            </div>

            {/* Tools */}
            <div class="space-y-1">
              <span class="text-[10px] uppercase font-bold text-zinc-500 tracking-wider flex items-center gap-1.5">
                <Hammer className="w-3.5 h-3.5 text-violet-400" />
                <span>Tools Used</span>
              </span>
              <div class="flex flex-wrap gap-1.5 pt-1">
                {project.data.tools.map((tool) => (
                  <span class="text-xs bg-zinc-900 border border-zinc-850 text-zinc-300 px-2 py-0.5 rounded">
                    {tool}
                  </span>
                ))}
              </div>
            </div>

            {/* Timeline */}
            <div class="space-y-1">
              <span class="text-[10px] uppercase font-bold text-zinc-500 tracking-wider flex items-center gap-1.5">
                <Calendar className="w-3.5 h-3.5 text-violet-400" />
                <span>Timeline</span>
              </span>
              <p class="text-sm font-semibold text-zinc-200">{project.data.date}</p>
            </div>

            {/* Deliverables */}
            <div class="space-y-1">
              <span class="text-[10px] uppercase font-bold text-zinc-500 tracking-wider flex items-center gap-1.5">
                <CheckSquare className="w-3.5 h-3.5 text-violet-400" />
                <span>Deliverables</span>
              </span>
              <ul class="text-sm font-medium text-zinc-300 list-disc pl-4 space-y-1">
                {project.data.deliverables.map((del) => (
                  <li class="leading-relaxed">{del}</li>
                ))}
              </ul>
            </div>

            {/* Project Links */}
            {(project.data.liveUrl || project.data.figmaUrl) && (
              <div class="pt-4 border-t border-zinc-850 flex flex-col gap-2.5">
                {project.data.liveUrl && (
                  <a
                    href={project.data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center gap-2 text-xs font-bold text-white bg-gradient-to-r from-violet-600 to-blue-600 hover:from-violet-500 hover:to-blue-500 py-2.5 px-4 rounded-lg transition-colors"
                  >
                    <span>Visit Live Site</span>
                    <ExternalLink className="w-3.5 h-3.5" />
                  </a>
                )}
                {project.data.figmaUrl && (
                  <a
                    href={project.data.figmaUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center gap-2 text-xs font-bold text-zinc-200 bg-zinc-900 border border-zinc-800 hover:border-zinc-700 py-2.5 px-4 rounded-lg transition-colors"
                  >
                    <span>View Figma File</span>
                    <ExternalLink className="w-3.5 h-3.5" />
                  </a>
                )}
              </div>
            )}
          </aside>

          {/* Right Rich Content Panel (8 cols on desktop) */}
          <article class="lg:col-span-8 bg-zinc-900/10 border border-zinc-900/60 rounded-2xl p-6 sm:p-10">
            <div class="prose max-w-none">
              <Content />
            </div>
          </article>

        </div>
      </div>
    </section>

    {/* Next/Previous Case Study Footer Navigation */}
    <section class="border-t border-zinc-900 bg-zinc-950 py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {/* Previous case (older) */}
          {prevProject ? (
            <a
              href={`/projects/${prevProject.id}`}
              class="group flex flex-col items-start p-6 bg-zinc-900/20 border border-zinc-850 hover:border-zinc-750 hover:bg-zinc-900/40 rounded-xl transition-all"
            >
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-2 group-hover:text-violet-400 transition-colors">
                <ChevronLeft className="w-3.5 h-3.5" />
                <span>Previous Case Study</span>
              </span>
              <span class="text-sm font-bold text-zinc-200 group-hover:text-white transition-colors line-clamp-1">
                {prevProject.data.title}
              </span>
            </a>
          ) : (
            <div class="p-6 bg-zinc-900/5 border border-zinc-900 rounded-xl opacity-30 flex items-center justify-center text-xs text-zinc-650 font-bold tracking-widest uppercase">
              First Case Study
            </div>
          )}

          {/* Next case (newer) */}
          {nextProject ? (
            <a
              href={`/projects/${nextProject.id}`}
              class="group flex flex-col items-end p-6 bg-zinc-900/20 border border-zinc-850 hover:border-zinc-750 hover:bg-zinc-900/40 rounded-xl transition-all"
            >
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-2 group-hover:text-violet-400 transition-colors">
                <span>Next Case Study</span>
                <ChevronRight className="w-3.5 h-3.5" />
              </span>
              <span class="text-sm font-bold text-zinc-200 group-hover:text-white transition-colors line-clamp-1 text-right">
                {nextProject.data.title}
              </span>
            </a>
          ) : (
            <div class="p-6 bg-zinc-900/5 border border-zinc-900 rounded-xl opacity-30 flex items-center justify-center text-xs text-zinc-650 font-bold tracking-widest uppercase">
              Latest Case Study
            </div>
          )}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
