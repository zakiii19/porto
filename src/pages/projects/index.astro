---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import ProjectsDirectory from '../../components/ProjectsDirectory';

const allProjects = await getCollection('projects');

// Sort projects by date descending
const sortedProjects = allProjects.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Layout title="Case Studies Directory | Jane Doe" description="Explore Jane Doe's interdisciplinary case studies spanning System Analysis, UI/UX Redesigns, and Graphic Design.">
  <Navbar client:load />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 flex-grow">
    {/* Header */}
    <div class="mb-12">
      <span class="text-[10px] uppercase font-bold tracking-widest text-violet-400 block mb-3">
        CREATIVE & SYSTEM PORTFOLIO
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        Project Directory
      </h1>
      <p class="text-zinc-400 text-sm sm:text-base max-w-xl">
        Filter case studies by category to explore specific systems analyses, user research models, wireframe structures, or branding assets.
      </p>
    </div>

    {/* Filtering Grid Directory */}
    <ProjectsDirectory client:load projects={sortedProjects} />
  </main>

  <Footer />
</Layout>
