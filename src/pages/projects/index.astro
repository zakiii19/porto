---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import ProjectsDirectory from '../../components/ProjectsDirectory';
import Footer from '../../components/Footer';

const allProjects = await getCollection('projects');
const sorted = allProjects
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.localeCompare(a.data.date))
  .map((entry) => ({
    slug: entry.id.replace(/\.mdx?$/, ''),
    title: entry.data.title,
    category: entry.data.category,
    featured: entry.data.featured,
    date: entry.data.date,
    summary: entry.data.summary,
    thumbnail: entry.data.thumbnail,
    role: entry.data.role,
    tools: entry.data.tools,
  }));
---

<Layout title="Karya & Proyek | Qolbul Muzaki">
  <Navbar client:load />
  <main class="flex-1">
    <ProjectsDirectory client:load projects={sorted} />
  </main>
  <Footer />
</Layout>
