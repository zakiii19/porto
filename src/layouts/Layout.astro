---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
}

const {
  title = "Qolbul Muzaki | UI/UX Designer & Certified System Analyst",
  description = "Portfolio Qolbul Muzaki — UI/UX Designer & BNSP Certified System Analyst. Memadukan riset UX, arsitektur sistem, dan visual storytelling yang berani.",
  image = null
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321');
---

<!DOCTYPE html>
<html lang="id" data-theme="light" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/my-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Prevent theme/lang FOUC & skip preloader if already seen in session -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('qm_theme');
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.setAttribute('data-theme', theme);
          }
          var lang = localStorage.getItem('qm_lang');
          if (lang === 'en' || lang === 'id') {
            document.documentElement.lang = lang;
          }
          if (
            sessionStorage.getItem('qm_booted') === '1' ||
            (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)
          ) {
            document.documentElement.setAttribute('data-booted', 'true');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google Fonts: Plus Jakarta Sans + Instrument Serif Italic (v8 Typography) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {image && <meta property="twitter:image" content={image} />}
    <style is:inline>
      html[data-booted="true"] #qm-preloader {
        display: none !important;
      }
      #qm-preloader {
        transition: transform 0.65s cubic-bezier(0.76, 0, 0.24, 1), opacity 0.45s ease;
      }
      #qm-preloader.is-leaving {
        transform: translateY(-100%);
        opacity: 0;
        pointer-events: none;
      }
      @keyframes qmOrbitSpin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      @keyframes qmOrbitSpinReverse {
        from { transform: rotate(360deg); }
        to { transform: rotate(0deg); }
      }
      @keyframes qmAvatarPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.04); }
      }
      .qm-orbit-cw {
        animation: qmOrbitSpin 7s linear infinite;
      }
      .qm-orbit-ccw {
        animation: qmOrbitSpinReverse 11s linear infinite;
      }
      .qm-avatar-pulse {
        animation: qmAvatarPulse 2.2s ease-in-out infinite;
      }
      [data-theme="dark"] #qm-preloader {
        color: #ffffff;
      }
      [data-theme="dark"] #qm-preloader .qm-ring-inner {
        border-color: rgba(250, 204, 21, 0.35);
      }
      [data-theme="dark"] #qm-preloader .qm-ring-outer {
        border-color: rgba(255, 255, 255, 0.16);
      }
      [data-theme="dark"] #qm-preloader .qm-orbit-dot {
        background-color: #facc15;
      }
      [data-theme="dark"] #qm-preloader .qm-greeting {
        color: #facc15;
      }
      [data-theme="dark"] #qm-preloader .qm-sub {
        color: rgba(255, 255, 255, 0.7);
      }
      [data-theme="dark"] #qm-preloader .qm-avatar-ring {
        background-color: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.16);
      }
      [data-theme="dark"] #qm-preloader .qm-track {
        background-color: rgba(255, 255, 255, 0.12);
      }
      [data-theme="dark"] #qm-preloader .qm-fill {
        background-color: #facc15;
      }
      [data-theme="dark"] #qm-preloader .qm-comet {
        background-color: #fde047;
        box-shadow: 0 0 12px rgba(250, 204, 21, 0.85);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-[#9333ea]/25 selection:text-[#9333ea]">
    <!-- Avatar Orbit & Greeting Preloader (1x per session) -->
    <div
      id="qm-preloader"
      class="hero-sunlit-canvas fixed inset-0 z-[9999] flex flex-col items-center justify-center px-6 text-[#181024]"
      aria-hidden="true"
    >
      <div class="dot-grid-overlay absolute inset-0 opacity-25 pointer-events-none"></div>

      <div class="relative z-10 flex flex-col items-center">
        <!-- Orbital Avatar Stage -->
        <div class="relative w-40 h-40 sm:w-52 sm:h-52 flex items-center justify-center mb-7 sm:mb-8">
          <!-- Outer Dashed Orbit -->
          <div class="qm-orbit-ccw qm-ring-outer absolute inset-0 rounded-full border border-dashed border-[#9333ea]/25">
            <span class="qm-orbit-dot absolute -top-1 left-1/2 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-[#9333ea]/70"></span>
          </div>

          <!-- Inner Solid Orbit -->
          <div class="qm-orbit-cw qm-ring-inner absolute inset-3.5 sm:inset-4 rounded-full border border-[#9333ea]/35">
            <span class="qm-orbit-dot absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-[#facc15] shadow-sm"></span>
          </div>

          <!-- Center 3D Avatar -->
          <div class="qm-avatar-pulse qm-avatar-ring relative z-10 w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border border-[#9333ea]/20 bg-[#f3e8ff]/85 grid place-items-center shadow-md">
            <img src="/my-icon.png" alt="Qolbul Muzaki" class="w-20 h-20 sm:w-24 sm:h-24 object-contain" />
          </div>
        </div>

        <!-- Greeting & Identity -->
        <div class="text-center space-y-1.5 mb-7 sm:mb-8">
          <span id="qm-greeting-text" class="qm-greeting inline-block text-xs sm:text-sm font-extrabold tracking-[0.18em] uppercase text-[#9333ea]">
            Halo, Selamat Datang
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight">Qolbul Muzaki</h2>
          <p id="qm-role-text" class="qm-sub text-xs sm:text-sm font-semibold text-[#5b516a]">
            UI/UX Designer · Analis Sistem (BNSP)
          </p>
        </div>

        <!-- Kinetic Progress Bar with Gliding Comet Tip -->
        <div class="w-64 sm:w-80 flex flex-col items-center gap-2.5">
          <div class="qm-track relative w-full h-1.5 sm:h-2 rounded-full bg-[#9333ea]/15 overflow-visible">
            <div
              id="qm-progress-fill"
              class="qm-fill relative h-full w-0 rounded-full bg-[#9333ea]"
            >
              <span
                class="qm-comet absolute -right-1.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-full bg-[#facc15] shadow-[0_0_12px_rgba(147,51,234,0.6)]"
              ></span>
            </div>
          </div>
          <span id="qm-progress-pct" class="qm-greeting text-[11px] sm:text-xs font-mono font-bold text-[#9333ea]">
            0%
          </span>
        </div>
      </div>

      <button
        id="qm-skip-btn"
        type="button"
        class="qm-sub relative z-10 mt-6 px-3.5 py-1.5 rounded-full text-[11px] font-bold border border-[#9333ea]/20 hover:border-[#9333ea]/50 transition-colors cursor-pointer"
      >
        Lewati →
      </button>
    </div>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (root.getAttribute('data-booted') === 'true') return;

        var preloader = document.getElementById('qm-preloader');
        var greeting = document.getElementById('qm-greeting-text');
        var role = document.getElementById('qm-role-text');
        var skipBtn = document.getElementById('qm-skip-btn');
        var fill = document.getElementById('qm-progress-fill');
        var pct = document.getElementById('qm-progress-pct');
        if (!preloader || !fill || !pct) return;

        var isEn = root.lang === 'en';
        if (greeting) greeting.textContent = isEn ? 'Hello, Welcome' : 'Halo, Selamat Datang';
        if (role) {
          role.textContent = isEn
            ? 'UI/UX Designer · System Analyst (BNSP)'
            : 'UI/UX Designer · Analis Sistem (BNSP)';
        }
        if (skipBtn) skipBtn.textContent = isEn ? 'Skip →' : 'Lewati →';

        var done = false;
        function dismiss() {
          if (done) return;
          done = true;
          fill.style.width = '100%';
          pct.textContent = '100%';
          try {
            sessionStorage.setItem('qm_booted', '1');
          } catch (e) {}
          preloader.classList.add('is-leaving');
          setTimeout(function () {
            root.setAttribute('data-booted', 'true');
          }, 660);
        }

        if (skipBtn) {
          skipBtn.addEventListener('click', dismiss);
        }

        var start = performance.now();
        var duration = 2250;

        function tick(now) {
          if (done) return;
          var t = Math.min(1, (now - start) / duration);
          // Smooth fast-start, steady glide, crisp finish
          var eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
          var val = Math.round(eased * 100);
          fill.style.width = val + '%';
          pct.textContent = val + '%';

          if (t < 1) {
            requestAnimationFrame(tick);
          } else {
            setTimeout(dismiss, 140);
          }
        }

        requestAnimationFrame(tick);
      })();
    </script>

    <slot />
  </body>
</html>
